# ─── Application ──────────────────────────────────────────────
APP_NAME="DOSHost"
APP_DESCRIPTION="Your own DOS machines in the browser. Create an instance, boot it, and your C: drive is saved for you."
APP_URL=http://localhost:8000
APP_DEBUG=true
APP_TIMEZONE=Europe/Rome
# Default language and available languages (comma separated, must exist in /lang)
APP_LOCALE=en
APP_LOCALES=en,it

# ─── Database (MySQL) ─────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=doshost
DB_USERNAME=doshost
DB_PASSWORD=secret

# ─── Session ──────────────────────────────────────────────────
SESSION_NAME=doshost_session

# ─── Features ────────────────────────────────────────────────
# Set to false to close public sign-ups (initial value, can be changed from the back-office)
REGISTRATION_ENABLED=true
# New users must confirm their email address before signing in (needs a working MAIL_* setup)
EMAIL_VERIFICATION=false
# Instances per user (can be changed from the back-office, globally or per user)
DEFAULT_MAX_INSTANCES=3
# Automatic save of the DOS disk, in minutes (initial value, can be changed from the back-office)
AUTOSAVE_MINUTES=5
# Max size of an instance disk (C: drive, zip compressed), in MB.
# Over this size the instance stops saving until some data is deleted.
DISK_MAX_MB=64
# Show a warning next to the instance when its disk reaches this percentage
DISK_WARN_PERCENT=80

# Private data (instance disks, avatars, logs). Default: storage/ inside the project.
# Absolute path, or relative to the project folder. It must NOT be reachable from the web:
# e.g. STORAGE_PATH=../doshost-data  →  a folder next to the project, outside htdocs.
# STORAGE_PATH=storage

# ─── Email ────────────────────────────────────────────────────
# MAIL_DRIVER: mail (PHP mail(), fine on most shared hosting), smtp, or log (writes to storage/logs/mail.log)
MAIL_DRIVER=mail
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="DOSHost"
# Only for MAIL_DRIVER=smtp. MAIL_ENCRYPTION: tls (STARTTLS, usually port 587), ssl (465) or none
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=

# ─── Rate limits ──────────────────────────────────────────────
# Counted per account (the email typed at sign-in, or the signed-in user); sign-ups with one counter
# for the whole site. No IP address is stored: counters are kept under a hash and forgotten when they expire.
# Wrong passwords at sign-in, per account, then a pause of THROTTLE_LOGIN_MINUTES
THROTTLE_LOGIN_ATTEMPTS=5
THROTTLE_LOGIN_MINUTES=15
# Wrong current password when changing it or deleting the account
THROTTLE_PASSWORD_ATTEMPTS=5
THROTTLE_PASSWORD_MINUTES=15
# Sign-up attempts per hour on the whole site; above it everyone is asked to try again later
THROTTLE_REGISTER_PER_HOUR=30
# New confirmation emails per address, per hour
THROTTLE_RESEND_PER_HOUR=3

# ─── Users ────────────────────────────────────────────────────
# Max size of an uploaded profile picture, in KB (it is cropped to 256x256)
AVATAR_MAX_KB=4096

# ─── First administrator (created by `php bin/migrate.php` if missing) ─
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# ─── Legal (shown in the Privacy and Cookie policies) ─────────
# Data controller (company or person running this site), address and privacy contact
LEGAL_CONTROLLER_NAME="Your Company S.r.l."
LEGAL_CONTROLLER_ADDRESS="Street 1, 00100 City, Italy"
LEGAL_CONTACT_EMAIL=privacy@example.com
# Where the server is located
LEGAL_DATA_LOCATION="the European Union"
# How long the web server keeps its technical access logs, in days
LEGAL_LOG_RETENTION_DAYS=30
# Date of the current version of the policies (YYYY-MM-DD)
LEGAL_POLICY_DATE=2026-10-16
